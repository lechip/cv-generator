{
  "name": "data-driven-cv-generator",
  "version": "0.1.0",
  "type": "module",
  "description": "Data-driven JSON Resume tooling with deterministic PDF, HTML, Markdown, and ODT output.",
  "license": "MIT",
  "author": "Oscar Barrios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lechip/cv-generator.git"
  },
  "homepage": "https://github.com/lechip/cv-generator#readme",
  "bugs": {
    "url": "https://github.com/lechip/cv-generator/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cv": "node --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:pdf": "RUN_PDF_TESTS=1 node --import tsx --test tests/pdf.test.ts",
    "test:odt": "RUN_ODT_TESTS=1 node --import tsx --test tests/odt.test.ts",
    "check": "pnpm build && pnpm test",
    "fonts": "node scripts/embed-fonts.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@jsonresume/schema": "^1.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
