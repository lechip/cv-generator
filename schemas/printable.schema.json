{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/cv-generator/printable.schema.json",
  "title": "Printable JSON Resume",
  "allOf": [{ "$ref": "http://example.com/example.json" }],
  "type": "object",
  "required": ["basics", "work", "education", "skills", "languages", "meta", "x-cv"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["x-cv"],
      "properties": {
        "x-cv": {
          "type": "object",
          "required": ["kind", "canonicalPath", "canonicalSha256", "useCase", "targetJob", "focus", "selectedWorkIds", "omittedWorkIds"],
          "properties": {
            "kind": { "const": "printable" },
            "language": { "type": "string", "minLength": 2 },
            "canonicalPath": { "type": "string", "minLength": 1 },
            "canonicalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "useCase": { "type": "string", "minLength": 1 },
            "targetJob": { "type": ["string", "null"] },
            "focus": { "enum": ["recent", "relevant", "balanced"] },
            "selectedWorkIds": { "type": "array", "items": { "type": "string" } },
            "omittedWorkIds": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "x-cv": {
      "type": "object",
      "required": ["strengths", "otherExperience"],
      "properties": {
        "strengths": { "type": "array", "minItems": 1 },
        "otherExperience": {
          "type": "object",
          "required": ["count", "totalCareerEntries", "dateRange", "highlightedWorkIds", "highlightedNames", "summary"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "totalCareerEntries": { "type": "integer", "minimum": 1 },
            "dateRange": { "type": "string", "minLength": 1 },
            "highlightedWorkIds": { "type": "array", "items": { "type": "string" } },
            "highlightedNames": { "type": "array", "items": { "type": "string" } },
            "summary": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language", "fluency", "x-cv"],
        "properties": {
          "x-cv": {
            "type": "object",
            "required": ["sourceId", "proficiency"],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 },
              "proficiency": { "$ref": "#/definitions/cefrProficiency" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "cefrProficiency": {
      "type": "object",
      "required": ["framework", "level"],
      "properties": {
        "framework": { "const": "CEFR" },
        "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "status": { "enum": ["native", "bilingual"] }
      },
      "if": { "required": ["status"] },
      "then": { "properties": { "level": { "const": "C2" } } }
    }
  }
}
